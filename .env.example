# AutoMate Environment Variables
# Copy this file to .env.local and fill in your values

# Google Gemini API Key (required for AI analysis)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Upstash Redis (optional — enables rate limiting: 5 requests/24h)
# Get credentials at: https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Site URL (optional — used for SEO/sitemap generation)
# Defaults to https://automate.vercel.app
NEXT_PUBLIC_SITE_URL=
